<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='ida_model'>
    <static>true</static>

    <!-- Main hull link — named base_link to match TF2 convention -->
    <link name='base_link'>
      <visual name='visual'>
        <pose>0 0 0.5 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>Montaj1.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name='collision'>
        <pose>0 0 0.5 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>Montaj1.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <!-- IMU — 100 Hz, body-fixed, provides orientation and angular velocity -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu/data</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- GPS — 10 Hz, 0.5 m horizontal noise (typical marine GPS) -->
      <sensor name="gps_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/gps/fix</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <navsat>
          <position_sensing>
            <horizontal>
              <noise type="gaussian"><mean>0</mean><stddev>0.5</stddev></noise>
            </horizontal>
            <vertical>
              <noise type="gaussian"><mean>0</mean><stddev>0.5</stddev></noise>
            </vertical>
          </position_sensing>
        </navsat>
      </sensor>

    </link>

    <!-- Fixed joint attaching the LiDAR mount to the hull -->
    <joint name='lidar_joint' type='fixed'>
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- LiDAR link — positioned 0.5m forward and 0.5m above the hull origin -->
    <link name='lidar_link'>
      <pose>0.5 0 0.5 0 0 0</pose>

      <!-- RPLIDAR C1: single horizontal plane, 360°, 12 m range, 10 Hz -->
      <sensor name='lidar_2d' type='gpu_lidar'>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1080</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
          </range>
        </lidar>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
      </sensor>
    </link>

  </model>
</sdf>
