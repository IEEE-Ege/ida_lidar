# To be added to the main model #
<sensor name="lidar_3d" type="gpu_lidar">
    <pose>0.5 0 0.5 0 0 0</pose> 
    <always_on>true</always_on>
    <update_rate>10</update_rate> <lidar>
        <scan>
            <horizontal>
                <samples>1024</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.26</min_angle>
                <max_angle>0.26</max_angle>
            </vertical>
        </scan>
        <range>
            <min>0.5</min>
            <max>100.0</max>
        </range>
    </lidar>
    <topic>/gazebo_lidar/points</topic> 
</sensor>
